# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase Anda.
# Ambil dari: Supabase Dashboard > Project Settings > API
# Variabel harus diawali VITE_ agar bisa dibaca di kode React (import.meta.env).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini
